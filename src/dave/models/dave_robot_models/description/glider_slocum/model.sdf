<?xml version="1.0"?>
<sdf version="1.7">
  <model name="glider_slocum">

    <static>false</static>
    <link name="base_link">
      <inertial>
        <pose>0 0.00354 -0.02 0 0 0</pose>
        <mass>73.498</mass>
        <inertia>
          <ixx>13.193856</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.418962</iyy>
          <iyz>0</iyz>
          <izz>13.193856</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <!-- <uri>model://meshes/glider_slocum/Slocum-Glider.dae</uri> -->
            <uri>model://meshes/glider_slocum/Slocum-Torpedo.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="base_link_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <!-- <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://meshes/glider_slocum/COLLISION-Slocum-Glider.dae</uri>
          </mesh> -->
          <box>
            <size>0.22 1.5 0.22</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="imu_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name='battery_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <battery name='battery'>
        <voltage>4.2</voltage>
      </battery>
    </link>

    <joint name='battery_joint' type='fixed'>
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>battery_link</child>
    </joint>

    <plugin
      filename="gz-sim-linearbatteryplugin-system"
      name="gz::sim::systems::LinearBatteryPlugin">
      <battery_name>battery</battery_name>
      <voltage>4.2</voltage>
      <open_circuit_voltage_constant_coef>3.7</open_circuit_voltage_constant_coef>
      <open_circuit_voltage_linear_coef>-3.1424</open_circuit_voltage_linear_coef>
      <initial_charge>4.32</initial_charge>
      <capacity>4.8</capacity>
      <resistance>0.002</resistance>
      <smooth_current_tau>1.9499</smooth_current_tau>
      <enable_recharge>false</enable_recharge>
      <power_load>10</power_load>
      <start_on_motion>true</start_on_motion>
    </plugin>

    <link name="navsat_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/model/glider_slocum/navsat</topic>
      </sensor>
    </link>

    <joint name="navsat_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>navsat_link</child>
    </joint>

    <!-- ========================================================= -->
    <!-- 이 코드 영역(시작)은 기존 프로펠러임  -->
    <!-- ========================================================= -->

    <link name="propeller_link">
      <visual name="propeller_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://meshes/glider_slocum/Slocum-Glider-Propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1</iyy>
          <iyz>0</iyz>
          <izz>0.05</izz>
        </inertia>
        <mass>0.25</mass>
      </inertial>
    </link>

    <joint name="propeller_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>propeller_link</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>glider_slocum</namespace>
      <joint_name>propeller_joint</joint_name>
      <fluid_density>1025.0</fluid_density>
      <thrust_coefficient>0.02</thrust_coefficient>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>false</velocity_control>
      <use_angvel_cmd>false</use_angvel_cmd>
    </plugin>

    <!-- ========================================================= -->
    <!-- 이 코드 영역(끝)은 기존 프로펠러임  -->
    <!-- ========================================================= -->



    <!-- ========================================================= -->
    <!-- 이 코드 영역(시작)은 추가한 뒤쪽(y -0.03m) 프로펠러임  -->
    <!-- ========================================================= -->

    <link name="propeller_rear_link">
      <visual name="propeller_rear_visual">
        <!-- 기존 프로펠러보다 Y축으로 0.03 m 후방 -->
        <pose>0 -0.03 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://meshes/glider_slocum/Slocum-Glider-Propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1</iyy>
          <iyz>0</iyz>
          <izz>0.05</izz>
        </inertia>
        <mass>0.25</mass>
      </inertial>
    </link>

    <joint name="propeller_rear_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>propeller_rear_link</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>glider_slocum</namespace>
      <joint_name>propeller_rear_joint</joint_name>
      <fluid_density>1025.0</fluid_density>
      <thrust_coefficient>-0.02</thrust_coefficient>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>false</velocity_control>
      <use_angvel_cmd>false</use_angvel_cmd>
    </plugin>

    <!-- ========================================================= -->
    <!-- 이 코드 영역(시작)은 추가한 뒤쪽(y -0.03m) 프로펠러임  -->
    <!-- ========================================================= -->


    <!-- ========================================================= -->
    <!-- [1단계] 핀 링크 정의 (Y축 기준 꼬리에 부착) -->
    <!-- ========================================================= -->
    <link name="fin_top">
      <pose relative_to="base_link">0 -0.65 0.08 0 0 0</pose> <!-- Y: -0.7, Z: +0.08 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="fin_top_visual">
        <geometry><box><size>0.02 0.15 0.25</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>

    <link name="fin_bottom">
      <pose relative_to="base_link">0 -0.65 -0.08 0 0 0</pose> <!-- Y: -0.7, Z: -0.08 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="fin_bottom_visual">
        <geometry><box><size>0.02 0.15 0.25</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>
    
    <link name="fin_left">
      <pose relative_to="base_link">-0.08 -0.65 0 0 0 0</pose> <!-- X: -0.08, Y: -0.7 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="fin_left_visual">
        <geometry><box><size>0.25 0.15 0.02</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>
    
    <link name="fin_right">
      <pose relative_to="base_link">0.08 -0.65 0 0 0 0</pose> <!-- X: +0.08, Y: -0.7 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="fin_right_visual">
        <geometry><box><size>0.25 0.15 0.02</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>

    <!-- ========================================================= -->
    <!-- [2단계] 핀 조인트 (전진 방향 Y축에 맞춘 회전축) -->
    <!-- ========================================================= -->
    <joint name="fin_top_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_top</child>
      <axis>
        <xyz>0 0 1</xyz> <!-- Z축 회전 (좌우 러더 역할) -->
        <limit><lower>-0.5</lower><upper>0.5</upper><effort>10</effort></limit>
        <dynamics><damping>0.1</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>
    
    <joint name="fin_bottom_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_bottom</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.5</lower><upper>0.5</upper><effort>10</effort></limit>
        <dynamics><damping>0.1</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>
    
    <joint name="fin_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_left</child>
      <axis>
        <xyz>1 0 0</xyz> <!-- X축 회전 (상하 엘리베이터 역할) -->
        <limit><lower>-0.5</lower><upper>0.5</upper><effort>10</effort></limit>
        <dynamics><damping>0.1</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>
    
    <joint name="fin_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_right</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.5</lower><upper>0.5</upper><effort>10</effort></limit>
        <dynamics><damping>0.1</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>

    <!-- ========================================================= -->
    <!-- [3단계] SITL 제어 인터페이스 -->
    <!-- ========================================================= -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fin_top_joint</joint_name>
      <topic>/model/glider_slocum/joint/fin_top/cmd_pos</topic>
      <p_gain>5.0</p_gain><i_gain>0.0</i_gain><d_gain>0.5</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fin_bottom_joint</joint_name>
      <topic>/model/glider_slocum/joint/fin_bottom/cmd_pos</topic>
      <p_gain>5.0</p_gain><i_gain>0.0</i_gain><d_gain>0.5</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fin_left_joint</joint_name>
      <topic>/model/glider_slocum/joint/fin_left/cmd_pos</topic>
      <p_gain>5.0</p_gain><i_gain>0.0</i_gain><d_gain>0.5</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fin_right_joint</joint_name>
      <topic>/model/glider_slocum/joint/fin_right/cmd_pos</topic>
      <p_gain>5.0</p_gain><i_gain>0.0</i_gain><d_gain>0.5</d_gain>
    </plugin>

    <!-- ========================================================= -->
    <!-- [4단계] Fin Lift & Drag (전진 방향 Y축에 맞춘 양력 방향) -->
    <!-- ========================================================= -->
    <!-- ========================================================= -->
    <!-- Fin Lift & Drag                                            -->
    <!-- Forward +Y / Right +X / Up +Z                              -->
    <!-- ========================================================= -->

    <!-- Left Fin: ±Z Lift → X축 Pitch 모멘트 -->
    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <link_name>fin_left</link_name>

      <air_density>1025.0</air_density>
      <a0>0.0</a0>

      <cla>1.3</cla>
      <cda>0.2</cda>

      <alpha_stall>0.26</alpha_stall>
      <cla_stall>-0.26</cla_stall>
      <cda_stall>0.9</cda_stall>

      <area>0.014</area>
      <cp>0 0 0</cp>

      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
    </plugin>

    <!-- Right Fin: ±Z Lift → X축 Pitch 모멘트 -->
    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <link_name>fin_right</link_name>

      <air_density>1025.0</air_density>
      <a0>0.0</a0>

      <cla>1.3</cla>
      <cda>0.2</cda>

      <alpha_stall>0.26</alpha_stall>
      <cla_stall>-0.26</cla_stall>
      <cda_stall>0.9</cda_stall>

      <area>0.014</area>
      <cp>0 0 0</cp>

      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
    </plugin>

    <!-- Top Fin: ±X Lift → Z축 Yaw 모멘트 -->
    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <link_name>fin_top</link_name>

      <air_density>1025.0</air_density>
      <a0>0.0</a0>

      <cla>1.3</cla>
      <cda>0.2</cda>

      <alpha_stall>0.26</alpha_stall>
      <cla_stall>-0.26</cla_stall>
      <cda_stall>0.9</cda_stall>

      <area>0.014</area>
      <cp>0 0 0</cp>

      <forward>0 1 0</forward>
      <upward>1 0 0</upward>
    </plugin>

    <!-- Bottom Fin: ±X Lift → Z축 Yaw 모멘트 -->
    <plugin
      filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <link_name>fin_bottom</link_name>

      <air_density>1025.0</air_density>
      <a0>0.0</a0>

      <cla>1.3</cla>
      <cda>0.2</cda>

      <alpha_stall>0.26</alpha_stall>
      <cla_stall>-0.26</cla_stall>
      <cda_stall>0.9</cda_stall>

      <area>0.014</area>
      <cp>0 0 0</cp>

      <forward>0 1 0</forward>
      <upward>1 0 0</upward>
    </plugin>
        
    <!-- ========================================================= -->
    <!-- 덮어쓰기 영역 끝.                                         -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1025.0</water_density>
      <!-- Added mass -->
      <xDotU>0</xDotU>
      <yDotV>0</yDotV>
      <zDotW>0</zDotW>
      <kDotP>0</kDotP>
      <mDotQ>0</mDotQ>
      <nDotR>0</nDotR>
      <!-- <xDotU>4</xDotU>
      <yDotV>95</yDotV>
      <zDotW>75</zDotW>
      <kDotP>0.4</kDotP>
      <mDotQ>27</mDotQ>
      <nDotR>32</nDotR> -->

      <!-- Linear Drag Coefficients -->
      <!-- diagonal terms -->
      <xU>-162</xU>
      <yV>-8</yV>
      <zW>-108</zW>
      <kP>-13</kP>
      <mQ>-20</mQ>
      <nR>-32</nR>
      <!-- cross terms -->
      <!-- <yR>150</yR>
      <zQ>-100</zQ>
      <mW>37</mW>
      <nV>-34</nV> -->

      <!-- Quadratic Drag Coefficients -->
      <xUabsU>0</xUabsU>
      <yVabsV>-12.474</yVabsV>
      <zWabsW>0</zWabsW>
      <kPabsP>0</kPabsP>
      <mQabsQ>0</mQabsQ>
      <nRabsR>0</nRabsR>
    </plugin>

    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
