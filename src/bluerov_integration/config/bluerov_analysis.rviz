Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF Frames1
        - /BlueROV Odometry1
        - /Torpedo Odometry1
        - /BlueROV Integration Markers1
        - /A* Reference Path1
        - /PPID Tracking Target1
      Splitter Ratio: 0.5
    Tree Height: 520
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 105
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: World Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.6
      Name: TF Frames
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.3
          Color: 0; 255; 0
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.2
          Color: 0; 255; 0
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 200
      Name: BlueROV Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 0.65
        Axes Length: 0.8
        Axes Radius: 0.08
        Color: 0; 255; 0
        Head Length: 0.25
        Head Radius: 0.08
        Shaft Length: 0.7
        Shaft Radius: 0.04
        Value: Arrow
      Topic: /model/bluerov2/odometry
      Unreliable: true
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.3
          Color: 30; 115; 255
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.2
          Color: 30; 115; 255
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 200
      Name: Torpedo Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 0.65
        Axes Length: 0.8
        Axes Radius: 0.08
        Color: 30; 115; 255
        Head Length: 0.25
        Head Radius: 0.08
        Shaft Length: 0.7
        Shaft Radius: 0.04
        Value: Arrow
      Topic: /torpedo/state/odometry
      Unreliable: true
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: BlueROV Integration Markers
      Namespaces:
        astar_goal: true
        astar_path: true
        bluerov2: true
        goal_arrow: true
        telemetry: true
        torpedo: true
        torpedo_barrier: true
        torpedo_center: true
        torpedo_live_barrier: true
        uuv_position: true
        vehicle_labels: true
      Topic:
        Depth: 20
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/uuv_astar_markers
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 130; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: A* Reference Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 255; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /uuv/reference_path
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Color: 0; 255; 0
      Enabled: true
      History Length: 1
      Name: Current Position Point
      Radius: 0.3
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /uuv/current_position_point
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Color: 255; 60; 60
      Enabled: true
      History Length: 1
      Name: Goal Point
      Radius: 0.45
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /uuv/goal_point
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Color: 255; 0; 255
      Enabled: true
      History Length: 1
      Name: PPID Tracking Target
      Radius: 0.5
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ppid/tracking_target
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Color: 30; 115; 255
      Enabled: true
      History Length: 1
      Name: Torpedo Center Point
      Radius: 0.35
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /uuv/torpedo_center_point
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 25; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 55
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -15
        Y: -15
        Z: -2
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 2.4
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1500
  X: 40
  Y: 40
